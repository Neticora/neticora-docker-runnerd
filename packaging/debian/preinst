#!/bin/sh
set -eu
. /etc/os-release
[ "$ID" = ubuntu ] && [ "$VERSION_ID" = 26.04 ] && [ "$(dpkg --print-architecture)" = amd64 ] || {
  echo 'This engineering package supports Ubuntu 26.04 amd64 only.' >&2; exit 1;
}
# Preserve running executables/workloads during replacement. An operator must
# explicitly drain and stop the daemon using the qualified recovery procedure.
# RUNNERD_SERVICE_GUARD
if [ -d /run/systemd/system ]; then runnerd_require_stopped; fi
if getent passwd neticora-runnerd >/dev/null; then
  service_uid=$(id -u neticora-runnerd) || exit 1
  service_gid=$(id -g neticora-runnerd) || exit 1
  service_groups=$(id -G neticora-runnerd) || exit 1
  [ "$service_uid" -gt 0 ] && [ "$service_gid" -gt 0 ] || exit 1
  [ -n "$service_groups" ] || exit 1
  # Configured groups, including explicitly authorized Docker access, persist
  # across upgrades. Never grant membership from a package maintainer script.
  for service_group in $service_groups; do
    case "$service_group" in
      0|*[!0-9]*) echo 'Runnerd group lookup must succeed and exclude the root group.' >&2; exit 1 ;;
    esac
  done
fi
