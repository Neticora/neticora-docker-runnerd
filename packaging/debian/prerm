#!/bin/sh
set -eu
if [ -d /run/systemd/system ] && systemctl is-active --quiet neticora-runnerd.service; then
  echo 'Drain and stop Runnerd explicitly before removal or upgrade. Persistent ownership must be retained.' >&2
  exit 1
fi
if [ "$1" = remove ] && [ -d /run/systemd/system ]; then systemctl disable neticora-runnerd.service >/dev/null 2>&1 || true; fi
