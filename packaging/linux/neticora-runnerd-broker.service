# Foundation only: no runtime mutations, admission, or automatic enablement.
[Unit]
Description=Neticora Runnerd execution broker foundation
After=local-fs.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/neticora-runnerd-broker --config /etc/neticora-runnerd-broker/config.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
KillMode=control-group
UMask=0077
StateDirectory=neticora-runnerd-broker
StateDirectoryMode=0700
RuntimeDirectory=neticora
RuntimeDirectoryMode=0755
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
# Foundation needs only ownership of its controller-group socket.
CapabilityBoundingSet=CAP_CHOWN

[Install]
WantedBy=multi-user.target
