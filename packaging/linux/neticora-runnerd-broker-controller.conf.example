# Qualification deployment only; install as neticora-runnerd.service.d/broker.conf
# with a brokerSocket configuration. Add EVERY provisioned alternative socket.
[Service]
SupplementaryGroups=
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
KillMode=control-group
FileDescriptorStoreMax=0
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock -/run/containerd -/run/k3s/containerd -/run/runnerd09-docker.sock
# Controller never sees the broker's mounted secret snapshots or ledger.
InaccessiblePaths=-/run/neticora-broker-bootstrap -/var/lib/neticora-runnerd-broker
