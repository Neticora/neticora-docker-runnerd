# Explicit operator recovery only. Drain the host on the platform first, stop
# the normal daemon, and configure the broker with runtime.bootRecoveryOnly.
# Runtime activation remains restricted to disposable qualification builds.
[Unit]
Description=Neticora Runnerd broker terminal reconciliation
After=network-online.target neticora-runnerd-broker.service
Requires=neticora-runnerd-broker.service
Conflicts=neticora-runnerd.service

[Service]
Type=oneshot
User=neticora-runnerd
Group=neticora-runnerd
ExecStart=/usr/bin/runnerd --config /etc/neticora-runnerd/config.json --recovery broker-finalize
UMask=0077
SupplementaryGroups=
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/neticora-runnerd /etc/neticora-runnerd /run/neticora-runnerd
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock -/run/containerd -/run/k3s/containerd -/run/runnerd09-docker.sock
InaccessiblePaths=-/run/neticora-broker-bootstrap -/var/lib/neticora-runnerd-broker
FileDescriptorStoreMax=0
KillMode=control-group
TimeoutStartSec=10min
